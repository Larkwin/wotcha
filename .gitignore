.venv/
__pycache__/
*.pyc
.pytest_cache/
# coverage.py writes a FILE named .coverage, plus .coverage.<host>.<pid>
# parallel-mode files. The old `.coverage/` matched a directory, which
# never exists, so the data file was never actually ignored.
.coverage
.coverage.*
htmlcov/
*.egg-info/
dist/
build/
cdk.out/

# agentcore toolkit machine-local state: hardcodes absolute local paths and
# account id, regenerated by `agentcore configure`/`deploy` on any machine.
.bedrock_agentcore.yaml
.bedrock_agentcore/

# Tool caches. .ruff_cache/ and .superpowers/ each drop their own nested
# .gitignore, which already excludes them -- but that is the tool's choice, not
# ours. Listed here so the repo stays protected if either stops doing it.
.ruff_cache/
.superpowers/

# Secrets. Nothing here today; this repo is PUBLIC, so make it impossible for a
# stray .env to be staged by accident.
.env
.env.*
!.env.example
*.pem
*.key
credentials
.aws/

# The real household: real names, real numbers, real history. The committed
# data/household.json is the public pseudonymous one; this is its counterpart
# and must never be tracked. seed_household.py takes --file, so which one is
# loaded is always stated.
data/household.local.json

# macOS
.DS_Store
